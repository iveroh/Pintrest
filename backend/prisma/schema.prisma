generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PintPosts {
  id              String    @id @default(cuid())
  title           String    @db.VarChar(100)
  description     String?
  created_at      DateTime @default(now()) @db.Timestamp(6)
  creator_id      String
  pints_consumed  Int       @default(0)
  image_url       String    @default("")
  image_public_id String?
  likes           Likes[]
  comments        Comments[]

  creator         Users     @relation(fields: [creator_id], references: [id])

  @@map("pint_posts")
}

model Users {
  id              String    @id @default(cuid())
  email           String   @unique @db.VarChar(255)
  password_hash   String   @db.VarChar(255)
  username        String    @unique @db.VarChar(100)
  display_name    String    @db.VarChar(100)
  bio             String
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  avatar_path     String
  avatar_public_id  String?
  banner_path     String
  banner_public_id  String?
  pint_posts      PintPosts[]
  likes           Likes[]
  comments        Comments[]
  following       Follower[] @relation("UserFollowing")
  followedBy      Follower[] @relation("UserFollowers")

  @@map("users")
}

model Likes {
  liked_by_id     String  
  post_id         String  

  liked_by        Users     @relation(fields: [liked_by_id], references: [id], onDelete: Cascade)
  post            PintPosts @relation(fields: [post_id], references: [id], onDelete: Cascade)
  
  @@id(name: "likeId", [liked_by_id, post_id])
  @@map("likes")
}

model Comments {
  id              String    @id @default(cuid())
  description     String
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  commented_by_id String
  post_id         String

  commented_by    Users     @relation(fields: [commented_by_id], references: [id], onDelete: Cascade)
  post            PintPosts @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Follower {
  user_id         String
  following_id    String

  user            Users     @relation("UserFollowing", fields: [user_id], references: [id], onDelete: Cascade)
  following       Users     @relation("UserFollowers", fields: [following_id], references: [id], onDelete: Cascade) 

  @@id(name: "FollowingId", [user_id, following_id])
  @@map("follower")
}